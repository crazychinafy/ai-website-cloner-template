# ─────────────────────────────────────────────────────────────
# 彩搜搜 环境变量示例（复制为 .env.local 使用；.env/.env.local 永不提交 Git）
# ─────────────────────────────────────────────────────────────

# 前台数据源：static（默认，读取静态快照）| mysql（仅 P4 导入验证通过后方可切换）
CONTENT_SOURCE=static

# MySQL 连接（static 模式下可不填；docker-compose 的 mysql 服务内网主机名为 mysql）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=facai8_admin
DB_USER=facai8_app
# 真实密码只放 .env.local / 部署环境注入，勿提交
DB_PASSWORD=
DB_POOL_SIZE=10

# 管理员 Session 有效期（小时），P3 生效；上限 720（30 天）
ADMIN_SESSION_TTL_HOURS=12

# CSRF HMAC 密钥（P3 必填于生产）：32-256 位随机串
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_CSRF_SECRET=

# 允许跨站访问后台写接口的 Origin 白名单（逗号分隔，绝对 URL；禁止 *；同源恒放行）
# 例：ADMIN_ALLOWED_ORIGINS=https://admin.example.com
#ADMIN_ALLOWED_ORIGINS=

# 初始管理员 bootstrap（P2 命令使用；成功后必须清除这两个变量）
#ADMIN_BOOTSTRAP_USERNAME=
#ADMIN_BOOTSTRAP_PASSWORD=

# 上传目录（生产容器挂载持久卷）
UPLOAD_DIR=/data/facai8/uploads

# ── 前台演示（既有 Mock 认证；仅本地）─────────────────────────
#SOURCE_TEST_USERNAME=demo
#SOURCE_TEST_PASSWORD=
