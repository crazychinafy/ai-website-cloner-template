# 依赖
node_modules/

# Next.js 构建产物
.next/
*.tsbuildinfo

# Next.js 管理的类型入口（官方约定：不入库，由 next dev/build/typegen 重新生成）
next-env.d.ts

# 环境变量：真实 env 永不提交；仅示例文件入库
.env
.env.local
.env.*.local
!.env.example

# 文档：克隆档案默认忽略（体积大），admin 系列文档保持版本控制
docs/*
!docs/ADMIN_SYSTEM_*.md
!docs/README.md
!docs/skills/

# Agent / 浏览器工具产物
.agents/
.claude/
.playwright-mcp/

# 日志与压缩包
*.log
*.rar
*.zip
*.7z

# 二进制 / 系统文件
*.so
.DS_Store
Thumbs.db
/00back00
