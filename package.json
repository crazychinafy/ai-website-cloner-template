    "lucide-react": "^1.6.0",
    "mysql2": "3.24.6",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
