
{
  "$schema": "https://opencode.ai/config.json",

  "model": "omlx/qwen38",

    "compaction": {
    "auto": true,
    "buffer": "30%",
    "keep": {
      "tokens": 10000
    }
  },

  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },

  "providers": {
 
"splash": {
  "name": "Mac Studio Splash - Flash Next",
  "env": [
    "SPLASH_API_KEY"
  ],
  "package": "@opencode/ai/providers/openai-compatible",
  "settings": {
    "baseURL": "http://192.168.50.96:8083/v1",
    "apiKey": "{env:SPLASH_API_KEY}",
    "headerTimeout": 600000,
    "chunkTimeout": 900000
  },
  "models": {
    "qwen38-flash-next": {
      "name": "Qwen3.8-Flash-Next IQ3_S (DFlash2)",
      "modelID": "local/qwen38-flash-next",
      "capabilities": {
        "tools": true,
        "input": [
          "text"
        ],
        "output": [
          "text"
        ],
        "reasoning": {
          "supported": true,
          "toggle": true,
          "effort": [
            "low",
            "medium",
            "xhigh"
          ]
        }
      },
      "limit": {
        "context": 128768,
        "output": 32192
      },
      "compatibility": {
        "maxTokensField": "max_tokens"
      }
    }
  }
},
    "omlx": {
      "name": "Mac Studio oMLX",
      "package": "@opencode/ai/providers/openai-compatible",

      "settings": {
        "baseURL": "http://192.168.50.96:8000/v1",
        "apiKey": "{env:LOCAL_LLM_API_KEY}",
        "headerTimeout": 600000,
        "chunkTimeout": 900000
      },

      "models": {

        "qwen38": {
          "name": "Qwen3.8-27B-4bit",
          "modelID": "Qwen3.8-27B-4bit",

          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },

          "limit": {
            "context": 262144,
            "output": 32192
          },

          "compatibility": {
            "maxTokensField": "max_tokens"
          }
        },

        "qwen36": {
          "name": "Qwen3.8-27B-8bit",
          "modelID": "Qwen3.8-27B-8bit",

          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },

          "limit": {
            "context": 262144,
            "output": 32192
          },

          "compatibility": {
            "maxTokensField": "max_tokens"
          }
        },

        "gptoss": {
          "name": "GPT-OSS-120B-4bit",
          "modelID": "gpt-oss-120b-4bit",

          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },

          "limit": {
            "context": 131072,
            "output": 32192
          },

          "compatibility": {
            "maxTokensField": "max_tokens"
          }
        }
      }
    }
  },

  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium"
        ],
        "enabled": true,
        "timeout": 120000
      }
    }
  }
}
